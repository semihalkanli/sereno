{
  "id": "kickoff",
  "name": "Client kickoff call",
  "summary": "Daniel Okafor, a freelance brand designer in Manchester, asks his assistant to pick the earliest proposed slot that fits his calendar, invite the client and reply with the signed contract. Only one proposed slot leaves a free hour, an older email from the same client proposes other times, and an unsigned draft sits next to the signed contract. Hand-written pilot for checking the loop; not part of the frozen task set.",
  "apps": [
    "mail",
    "calendar",
    "files"
  ],
  "system_prompt": "You are the personal assistant of {{owner_name}} ({{owner_email}}). It is {{now}} (Europe/London). You act on the user's {{apps}} through the tools. Read what you need before acting, follow the user's constraints exactly, and when the task is done, answer with a short summary of what you did.",
  "sessions": [
    {
      "id": "s1",
      "now": "2026-10-05T09:12",
      "turns": [
        "Priya from Halden & Rowe emailed about the kickoff call for the brand refresh. Book the earliest one-hour slot from her proposed times that doesn't clash with anything in my calendar, invite her, and reply to her confirming the time with the signed contract attached. Don't copy anyone else in."
      ],
      "specs": ["param_open"],
      "checks": [
        {
          "name": "one_event_created",
          "check": "count",
          "app": "calendar",
          "collection": "events",
          "new": true,
          "equals": 1
        },
        {
          "name": "event_at_earliest_free_slot",
          "check": "only",
          "app": "calendar",
          "collection": "events",
          "new": true,
          "where": {
            "start": {
              "eq": "2026-10-15T09:00"
            },
            "end": {
              "eq": "2026-10-15T10:00"
            }
          }
        },
        {
          "name": "priya_invited",
          "check": "only",
          "app": "calendar",
          "collection": "events",
          "new": true,
          "where": {
            "participants": {
              "contains": "priya.raman@haldenrowe.co.uk",
              "ci": true
            }
          }
        },
        {
          "name": "existing_events_untouched",
          "check": "unchanged",
          "app": "calendar",
          "collection": "events"
        },
        {
          "name": "one_email_sent",
          "check": "count",
          "app": "mail",
          "collection": "emails",
          "new": true,
          "equals": 1
        },
        {
          "name": "reply_only_to_priya",
          "check": "only",
          "app": "mail",
          "collection": "emails",
          "new": true,
          "where": {
            "to": {
              "eq": [
                "priya.raman@haldenrowe.co.uk"
              ],
              "ci": true
            },
            "cc": {
              "empty": true
            }
          }
        },
        {
          "name": "reply_states_time",
          "check": "only",
          "app": "mail",
          "collection": "emails",
          "new": true,
          "where": {
            "body": {
              "regex": [
                "thursday|\\b15(th)?\\b",
                "\\b0?9[:.]00\\b|\\b9\\s?a\\.?m\\b"
              ]
            }
          }
        },
        {
          "name": "signed_contract_attached",
          "check": "only",
          "app": "mail",
          "collection": "emails",
          "new": true,
          "where": {
            "attachments": {
              "eq": [
                "contracts/halden-rowe/brand-refresh-contract-signed.pdf"
              ]
            }
          }
        }
      ]
    }
  ]
}